# Web console
SENTINEL_PORT=8733
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# One or more vLLM endpoints. API keys are optional because /metrics is normally public.
VLLM_ENDPOINTS=[{"name":"DeepSeek-V4-Flash","url":"http://127.0.0.1:9003"}]

# Collection and retention
SAMPLE_INTERVAL=2
HISTORY_RETENTION_HOURS=168
BMC_SAMPLE_INTERVAL=5

# Cumulative accounting (v2.2)
# Monthly/yearly/traffic-cycle totals come from a durable daily rollup that is never pruned.
TZ_OFFSET_HOURS=8              # local timezone offset used for day/month/year/cycle boundaries
NET_CYCLE_START_DAY=20         # traffic cycle starts on this day of month (00:00 local)
NET_IFACE=                     # interface used for traffic; empty = default-route iface (WAN)
NET_CYCLE_BASE_GB=0            # optional manual baseline (GB) for the current cycle, seeded once
# Storm3 serial fan box (optional): explicit port or comma-separated candidates.
# Leave empty to auto-follow the vendor ch341 node (/dev/ttyCH341USB0).
STORM_PORT=

# Alert thresholds
GPU_TEMP_WARNING=78
GPU_TEMP_CRITICAL=86
GPU_MEMORY_WARNING=92
QUEUE_WARNING=16
